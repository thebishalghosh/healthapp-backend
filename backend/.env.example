APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=health_app
DB_USERNAME=your_database_user
DB_PASSWORD=your_database_password

API_VERSION=v1
CORS_ALLOWED_ORIGINS=

# Gemini configuration (keep the API key server-side and out of source control)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_VERSION=v1beta
GEMINI_TIMEOUT_SECONDS=20

# Razorpay Test Mode (server-side only)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_MODE=test
RAZORPAY_SUBSCRIPTION_TOTAL_COUNT=12
